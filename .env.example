# SaveIt Backend Environment Configuration
# Copy this file to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
API_VERSION=1.0.0

# Security
SECRET_KEY=change-me-to-a-random-64-char-string
ALLOWED_ORIGINS=*

# Rate Limiting
RATE_LIMIT=30/minute

# Download Limits
MAX_FILE_SIZE_MB=2048
MAX_DURATION_SECONDS=10800
MAX_CONCURRENT_MERGES=5

# Cache
METADATA_CACHE_TTL_SECONDS=600
METADATA_CACHE_MAX_SIZE=500

# Token
TOKEN_EXPIRY_SECONDS=300

# Temp Files
TEMP_DIR=/tmp/saveit
TEMP_CLEANUP_INTERVAL_SECONDS=600
TEMP_MAX_AGE_SECONDS=900

# FFmpeg
FFMPEG_PATH=ffmpeg
